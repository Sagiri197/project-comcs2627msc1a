command-centre/nodered/.config.*.json
command-centre/nodered/.flows*.backup
command-centre/nodered/flows_cred.json
command-centre/nodered/package.json
command-centre/nodered/package-lock.json
command-centre/nodered/node_modules/
command-centre/nodered/lib/
command-centre/nodered/context/

# Local overrides (passwords)
access-point/ap.env.local

