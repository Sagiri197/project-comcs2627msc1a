# Access point settings, read by access-point/linux/access-point.sh and
# access-point/windows/access-point.ps1.
# Override any of them in access-point/ap.env.local (git-ignored), e.g. to keep passwords out of git.
# DNS names, addresses and fixed leases are in dns.txt (Linux) and dns.windows.txt (Windows).

# --- Wi-Fi ---------------------------------------------------------------------------
WIFI_IFACE=wlan0               # Linux only (Windows uses its Mobile hotspot adapter)
WIFI_COUNTRY=PT                # Linux only: regulatory domain

# ESP32s only support 2.4 GHz, so the AP is fixed to band bg.
AP_SSID=comcs-cell1
AP_PASSWORD=comcs2627          # WPA2, at least 8 characters
AP_CHANNEL=6                   # Linux only (Windows picks the channel)

# --- ports used in the cell (shown at start-up; Windows opens them in the firewall) --
ALERT_SERVER_UDP_PORT=8080     # the alert server (hard-coded in server/daemon/src/main.cpp)
MQTT_PORT=1883                 # broker port on the Command Centre
