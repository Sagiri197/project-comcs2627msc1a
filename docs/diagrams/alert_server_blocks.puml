@startuml alert_server_blocks
title Alert Server - SysML Block Definition Diagram (server/)

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle folder
skinparam nodesep 50
skinparam ranksep 60
skinparam class {
  BackgroundColor<<block>> #FFFFFF
  BackgroundColor<<external>> #EEEEEE
  BackgroundColor<<library>> #F6F0E0
}
hide empty members
hide circle

legend right
  |= Line |= Meaning |
  | ◆━━ | part (composition: the owner creates and holds it) |
  | ◆━━> | part that the owner also calls |
  | ━━> | call (operation on the target block) |
  | ┄┄> | uses (link-time dependency) |
  | <color:red>━━</color> | network flow (UDP / MQTT) |
  Every module logs through spdlog (not drawn).
  GoogleTest builds one test executable per module.
endlegend

' ---- shared protocol and external systems --------------------------------------------------
class "ESP32 node" as ESP32 <<external>> {
  UDP client, JSON datagrams
}
class "MQTT broker\n(Command Centre)" as BROKER <<external>> {
  cc.comcs.lan:1883
}
class "common::protocol\n(shared module)" as PROTOCOL <<external>> {
  Reading: version, nodeId, sessionId, seq, qos
  payload: NGSI-LD WeatherObserved
  temperature, relativeHumidity (0..1)
  dateObserved, location, refDevice
  timeSynchronized (optional)
  --
  Message = Reading | Ack | Reject
  --
  decode(json) : Message
  encode(Message) : json
}
class "Power Automate\n(webhook)" as POWER_AUTOMATE <<external>> {
  email notification endpoint
}

' ---- daemon ---------------------------------------------------------------------------------
package "daemon  (alert_server executable)" as DAEMON {
  class "alert_server (main)" as MAIN <<block>> {
    load config, create store / logic / server
    receive loop: server.receive()
  }
  class "AlertServer" as SERVER <<block>> {
    receive() : ReceivedMessage
    send(Message, UdpEndpoint)
    --
    decode -> process -> save
    publish alert -> ACK for QoS 1
  }
}

' ---- configuration --------------------------------------------------------------------------
package "config" as CONFIG {
  class "ServerConfig" as SETTINGS <<block>> {
    values
    database path, UDP endpoint
    MQTT settings (optional)
    email webhook / recipient settings
    --
    load_server_config(path)
  }
}

' ---- application ----------------------------------------------------------------------------
package "application  (alert_logic)" as APP {
  class "AlertLogic" as LOGIC <<block>> {
    values
    TEMPERATURE_THRESHOLD = 2.0 °C
    HUMIDITY_THRESHOLD = 5.0 %
    temperature range [0, 50] °C
    humidity range [20, 80] %
    --
    processReading(Reading) : ComparisonResult?
    compare with last stored reading
  }
  interface "AlertNotifier" as NOTIFIER {
    sendAlert(AlertData) : bool
  }
}

' ---- persistency ----------------------------------------------------------------------------
package "persistency" as PERS {
  class "ReadingStore" as STORE <<block>> {
    values
    path = readings.sqlite3
    --
    save(Reading) : Inserted | Duplicate
    find(Identity) : Reading?
    getLastReading() : Reading?
  }
}

' ---- communication --------------------------------------------------------------------------
package "communication" as COMM {
  class "EmailNotifier" as EMAIL <<block>> {
    Power Automate webhook
    recipient email
    --
    sendAlert(AlertData) : bool
  }
  EMAIL .up.|> NOTIFIER
}

' ---- udp ------------------------------------------------------------------------------------
package "udp  (udp_socket)" as UDP {
  interface "IUdpSocket" as SOCKET {
    values
    endpoint = 0.0.0.0:8080
    --
    recv() : UdpDatagram
    send(data, UdpEndpoint)
  }
  class "PosixUdpSocket" as POSIX_SOCKET <<block>>
  class "WindowsUdpSocket" as WIN_SOCKET <<block>>
  POSIX_SOCKET .up.|> SOCKET
  WIN_SOCKET .up.|> SOCKET
}

' ---- mqtt -----------------------------------------------------------------------------------
package "mqtt  (mqtt_status)" as MQTT {
  class "MqttPublisher" as MQTTPUB <<block>> {
    connect / reconnect
    publish(topic, payload, qos, retained)
  }
  class "AlertPublisher" as ALERTPUB <<block>> {
    publish(Reading, ComparisonResult)
    MQTT alert topic, QoS 1
  }
  class "StatusPublisher" as STATUS <<block>> {
    values
    heartbeat interval from config
    --
    own thread
    publish heartbeat when connected
  }
  class "ServerStats" as STATS <<block>> {
    readings, invalidDatagrams, storageErrors
    lastReading
    --
    reading_received(node_id)
    invalid_datagram()
    storage_error()
    heartbeat_json(port) : string
    update hooks not wired to receive loop
  }
}

' ---- vendor ---------------------------------------------------------------------------------
package "vendor" as VENDOR {
  class "SQLite" as SQLITE <<library>> {
    sqlite3 C API
  }
  class "mosquitto" as MOSQUITTO <<library>> {
    libmosquitto_static
  }
  class "curl CLI" as CURL <<external>> {
    invoked by EmailNotifier for HTTP POST
  }
  class "spdlog" as SPDLOG <<library>> {
    console + logs/alert_server.log
  }
  class "GoogleTest" as GTEST <<library>> {
    unit tests only
  }
}

' ---- parts (who owns whom) ------------------------------------------------------------------
MAIN --> SETTINGS : load config
MAIN --> STORE : creates
MAIN --> LOGIC : creates
MAIN *-- "1" SERVER

' ---- calls (parts that the owner also calls) ------------------------------------------------
SERVER *--> "1" SOCKET : recv() / send(Ack)
SERVER --> LOGIC : processReading(reading)
SERVER --> STORE : save(reading)
LOGIC --> STORE : getLastReading()
SERVER *--> "0..1" MQTTPUB : when MQTT is enabled
SERVER *--> "0..1" ALERTPUB : when MQTT is enabled
SERVER *--> "0..1" STATUS : when MQTT is enabled
STATUS *-- "1" STATS
STATUS --> MQTTPUB : publish heartbeat
ALERTPUB --> MQTTPUB : publish alert
LOGIC ..> NOTIFIER : optional injection\n(not wired by main currently)
EMAIL --> CURL : invoke HTTP request
EMAIL -[#red]-> POWER_AUTOMATE : HTTPS webhook

' ---- uses -----------------------------------------------------------------------------------
SERVER ..> PROTOCOL : decode() / encode()
STORE ..> SQLITE
MQTTPUB ..> MOSQUITTO
MAIN ..> SPDLOG

' ---- network flows --------------------------------------------------------------------------
ESP32 -[#red]-> SOCKET : UDP :8080\nReading (JSON, QoS 0/1)
SOCKET -[#red]-> ESP32 : Ack / Reject
MQTTPUB -[#red]-> BROKER : MQTT\nalerts + heartbeat

@enduml
