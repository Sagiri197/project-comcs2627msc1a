# Raspberry Pi 5 deployment settings, sourced by the server/*.sh scripts.
# Override any of them in server/pi.env.local (git-ignored), e.g. to keep passwords out of git.

# How the Pi gets onto the cell's network:
#   ap     - the Pi creates its own Wi-Fi access point and runs DHCP/DNS for the ESP32s (default)
#   client - the Pi joins an existing Wi-Fi network (e.g. a phone hotspot)
#   none   - leave networking alone (e.g. Pi is on Ethernet and the ESP32s share that LAN)
WIFI_MODE=ap
WIFI_IFACE=wlan0
WIFI_COUNTRY=PT

# --- ap mode -------------------------------------------------------------------------
# ESP32s only support 2.4 GHz, so the AP is fixed to band bg.
AP_SSID=comcs-cell1
AP_PASSWORD=comcs2627          # WPA2, at least 8 characters
AP_CHANNEL=6
AP_ADDRESS=192.168.50.1        # the Pi's address on the AP; clients get 192.168.50.x by DHCP
AP_PREFIX=24
AP_DNS_NAME=comcs.lan          # resolves to AP_ADDRESS for AP clients (use as server_address)

# The Command Centre (MQTT broker + Node-RED) is a separate machine that joins this AP.
# Give it a fixed address so the ESP32s and the alert server can always find the broker:
# set COMMAND_CENTRE_MAC to the MAC of its Wi-Fi adapter (Windows: `getmac /v`,
# Linux: `ip link`). Left empty, it gets a random DHCP lease and the DNS name is not created.
COMMAND_CENTRE_MAC=4C-5F-70-44-0C-BE
COMMAND_CENTRE_ADDRESS=192.168.50.2       # outside the DHCP pool NetworkManager hands out
COMMAND_CENTRE_DNS_NAME=cc.comcs.lan      # use as the ESP32/alert-server MQTT broker host

# NTP for the AP's clients (ESP32s, Command Centre), served by chrony on the Pi at AP_ADDRESS /
# AP_DNS_NAME, udp/123. Works without Internet: the Pi then serves its own clock, so make sure
# it is right (Pi 5 RTC with a battery, Ethernet uplink, or server/set-time.sh).
NTP_SERVER=yes
NTP_LOCAL_STRATUM=10           # stratum advertised when serving the Pi's own clock

# --- client mode ---------------------------------------------------------------------
CLIENT_SSID="Redmi Note 13"
CLIENT_PASSWORD=plplplpl

# --- services ------------------------------------------------------------------------
# The alert server port is currently hard-coded in server/daemon/src/main.cpp.
ALERT_SERVER_UDP_PORT=8080
MQTT_PORT=1883
# yes: also run the command-centre/ Docker stack on the Pi (single-machine setup).
# no:  the Command Centre runs on its own machine connected to the AP (default).
RUN_COMMAND_CENTRE_ON_PI=no
