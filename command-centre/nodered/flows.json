    {
        "id": "in_weather",
        "type": "mqtt in",
        "z": "tab_cc",
        "name": "weather readings",
        "topic": "comcs/cell1/+/weather",
        "qos": "1",
        "datatype": "utf8",
        "broker": "broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 130,
        "y": 100,
        "wires": [
            [
                "f_parse"
            ]
        ]
