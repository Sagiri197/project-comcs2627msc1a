    {
        "id": "f_parse",
        "type": "function",
        "z": "tab_cc",
        "name": "Validate WeatherObserved",
        "func": "    // Accepts either a bare WeatherObserved (key-values) or the UDP protocol envelope\n// {\"kind\":\"reading\",\"payload\":{...WeatherObserved}} so both encodings work.\nconst MAX_LIVE_AGE_MS = 10000;   // older observations are rolling-window replays\nconst MAX_FUTURE_MS = 5000;      // tolerated clock skew\nconst now = Date.now();\nconst nodeFromTopic = msg.topic.split('/')[2];\n\nconst reject = (reason) => {\n    node.status({ fill: 'red', shape: 'ring', text: `${nodeFromTopic}: ${reason}` });\n    return [null, { topic: msg.topic, payload: { nodeId: nodeFromTopic, reason, raw: String(msg.payload).slice(0, 300) } }];\n};\n\nlet data;\ntry {\n    data = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    return reject('invalid JSON');\n}\nconst envelope = data && data.kind === 'reading' ? data : null;\nconst wo = envelope ? data.payload : data;\n\nif (!wo || typeof wo !== 'object') return reject('empty payload');\nif (wo.type !== 'WeatherObserved') return reject('type is not WeatherObserved');\nif (typeof wo.id !== 'string' || !wo.id.startsWith('urn:ngsi-ld:WeatherObserved:')) return reject('invalid id');\nif (typeof wo.temperature !== 'number' || !Number.isFinite(wo.temperature)) return reject('invalid temperature');\nif (typeof wo.relativeHumidity !== 'number' || wo.relativeHumidity < 0 || wo.relativeHumidity > 1) {\n    return reject('relativeHumidity must be a fraction in [0,1]');\n}\nconst observed = Date.parse(wo.dateObserved);\nif (Number.isNaN(observed)) return reject('invalid dateObserved');\n\n// Duplicate suppression: QoS 1 redelivery and rolling-window replays reuse the same id.\nconst seen = context.get('seen') || [];\nif (seen.includes(wo.id)) {\n    node.status({ fill: 'yellow', shape: 'dot', text: `duplicate ${wo.id.split(':').pop()}` });\n    return [null, null];\n}\nseen.push(wo.id);\nif (seen.length > 1000) seen.splice(0, seen.length - 1000);\ncontext.set('seen', seen);\n\nconst synced = (envelope ? envelope.timeSynchronized : wo.timeSynchronized) !== false;\nconst skewed = observed - now > MAX_FUTURE_MS;\n// Untrusted clocks: fall back to reception time.\nconst t = synced && !skewed ? observed : now;\nconst live = now - t <= MAX_LIVE_AGE_MS;\nconst nodeId = (wo.refDevice || '').replace('urn:ngsi-ld:Device:', '') || nodeFromTopic;\n\nnode.status({ fill: live ? 'green' : 'blue', shape: 'dot', text: `${nodeId} ${wo.temperature}°C ${live ? 'live' : 'replay'}` });\nreturn [{\n    topic: nodeId,\n    payload: {\n        nodeId,\n        temperature: wo.temperature,\n        humidity: Math.round(wo.relativeHumidity * 1000) / 10,   // percent\n        observedAt: t,\n        receivedAt: now,\n        live,\n        timeTrusted: synced && !skewed\n    }\n}, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 100,
        "wires": [
            [
                "f_cell",
                "f_health"
            ],
            [
                "dbg_invalid"
            ]
        ],
