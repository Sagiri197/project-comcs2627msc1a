    {
        "id": "sim_gen",
        "type": "function",
        "z": "tab_sim",
        "name": "simulate esp32-001/002",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "func": "        // Publishes WeatherObserved key-values for two nodes with a slowly drifting value.\n    const seq = (context.get('seq') || 0) + 1;\n    context.set('seq', seq);\n    const base = 22 + 2 * Math.sin(seq / 60);\n    const now = new Date().toISOString().replace(/\\.\\d+Z$/, 'Z');\n    const mk = (nodeId, dt, dh) => ({\n        topic: `comcs/cell1/${nodeId}/weather`,\n        qos: 1,\n        payload: JSON.stringify({\n            id: `urn:ngsi-ld:WeatherObserved:${nodeId}:sim:${seq}`,\n            type: 'WeatherObserved',\n            dateObserved: now,\n            location: { type: 'Point', coordinates: [-8.608, 41.178] },\n            refDevice: `urn:ngsi-ld:Device:${nodeId}`,\n            temperature: Math.round((base + dt + Math.random() * 0.4) * 10) / 10,\n            relativeHumidity: Math.round((0.5 + dh + Math.random() * 0.02) * 100) / 100\n        })\n    });\n    return [[mk('esp32-001', 0, 0), mk('esp32-002', 0.8, 0.03)]];",
        "x": 380,
        "y": 120,
        "wires": [
            [
                "sim_out"
            ]
        ]
    },
