    {
        "id": "f_broker",
        "type": "function",
        "z": "tab_cc",
        "name": "Broker state",
        "func": "    // Status events from the mqtt-in nodes: green = connected, red = disconnected, yellow = connecting.\nconst fill = msg.status && msg.status.fill;\nconst text = fill === 'green' ? 'Connected' : fill === 'yellow' ? 'Connecting…' : 'DISCONNECTED';\nif (context.get('last') === text) return null;\ncontext.set('last', text);\nreturn { payload: text };",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
