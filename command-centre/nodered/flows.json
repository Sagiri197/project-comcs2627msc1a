    {
        "id": "f_alert",
        "type": "function",
        "z": "tab_cc",
        "name": "Process alert",
        "func": "    // Expected payload: Smart Data Model \"Alert\" (key-values). Unknown shapes are still shown.\nconst MAX_ROWS = 50;\nconst log = context.get('log') || [];\nlet unacked = context.get('unacked') || 0;\nconst indicator = () => ({ payload: {\n    active: unacked > 0,\n    text: unacked > 0 ? `${unacked} unacknowledged · last: ${log[0].Description}` : 'No unacknowledged alerts'\n} });\n\nif (msg.topic === 'ack') {\n    unacked = 0;\n    context.set('unacked', 0);\n    node.status({ fill: 'green', shape: 'dot', text: 'acknowledged' });\n    return [null, null, indicator()];\n}\n\nlet a;\ntry {\n    a = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    a = { description: String(msg.payload) };\n}\nif (!a || typeof a !== 'object') a = { description: String(a) };\n\n// Deduplicate QoS 1 redeliveries by Alert id.\nconst ids = context.get('ids') || [];\nif (a.id && ids.includes(a.id)) return null;\nif (a.id) { ids.push(a.id); if (ids.length > 500) ids.shift(); context.set('ids', ids); }\n\nconst when = a.dateIssued ? new Date(a.dateIssued) : new Date();\nconst row = {\n    Time: isNaN(when) ? String(a.dateIssued) : when.toLocaleString('pt-PT'),\n    Severity: a.severity || 'unknown',\n    Category: a.subCategory || a.category || '',\n    Description: a.description || JSON.stringify(a).slice(0, 200),\n    Source: (a.alertSource || '').replace('urn:ngsi-ld:Device:', '')\n};\nlog.unshift(row);\nif (log.length > MAX_ROWS) log.length = MAX_ROWS;\nunacked += 1;\ncontext.set('log', log);\ncontext.set('unacked', unacked);\nnode.status({ fill: 'red', shape: 'dot', text: `${unacked} unacked: ${row.Description}` });\n\nreturn [\n    { payload: `⚠ [${row.Severity}] ${row.Description}` },\n    { payload: log },\n    indicator()\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
        "y": 740,
        "wires": [
            [
                "ui_notify"
            ],
            [
                "ui_tbl_alerts"
            ],
            [
                "ui_indicator"
            ]
        ],
        "outputLabels": [
            "notification",
            "alert log",
            "indicator"
        ]
