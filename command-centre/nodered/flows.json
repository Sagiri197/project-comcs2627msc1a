    {
        "id": "f_cell",
        "type": "function",
        "z": "tab_cc",
        "name": "Cell averages",
        "func": "    // Latest live reading per node; a node only counts towards the average while fresh.\nconst STALE_MS = 5000;\nconst latest = context.get('latest') || {};\nconst now = Date.now();\n\nif (msg.topic !== 'tick') {\n    const r = msg.payload;\n    const series = r.live ? r.nodeId : `${r.nodeId} (buffered)`;\n    if (r.live) {\n        latest[r.nodeId] = r;\n        context.set('latest', latest);\n    }\n    // Per-node history points at observation time (replays fill in the gaps).\n    return [null, null,\n        { topic: series, payload: { x: r.observedAt, y: r.temperature } },\n        { topic: series, payload: { x: r.observedAt, y: r.humidity } },\n        null];\n}\n\nconst fresh = Object.values(latest).filter((r) => now - r.receivedAt <= STALE_MS);\nif (fresh.length === 0) {\n    node.status({ fill: 'grey', shape: 'ring', text: 'no live nodes' });\n    return [null, null, null, null, { payload: 'No live data' }];\n}\nconst avg = (k) => Math.round(fresh.reduce((s, r) => s + r[k], 0) / fresh.length * 10) / 10;\nconst t = avg('temperature');\nconst h = avg('humidity');\nnode.status({ fill: 'green', shape: 'dot', text: `${t}°C ${h}% (${fresh.length} nodes)` });\nreturn [\n    { payload: t },\n    { payload: h },\n    { topic: 'average', payload: { x: now, y: t } },\n    { topic: 'average', payload: { x: now, y: h } },\n    { payload: `${fresh.length} node(s): ${fresh.map((r) => r.nodeId).sort().join(', ')}` }\n];",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 640,
        "y": 220,
        "wires": [
            [
                "ui_g_temp"
            ],
            [
                "ui_g_hum"
            ],
            [
                "ui_c_temp"
            ],
            [
                "ui_c_hum"
            ],
            [
                "ui_t_nodes"
            ]
        ],
        "outputLabels": [
            "avg temperature",
            "avg humidity",
            "temperature chart",
            "humidity chart",
            "contributing nodes"
        ]
