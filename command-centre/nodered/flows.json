        "format": "<template>\n  <div class=\"d-flex align-center\" style=\"gap: 12px\">\n    <v-icon :color=\"active ? 'red' : 'green'\" size=\"x-large\">{{ active ? 'mdi-alert' : 'mdi-check-circle' }}</v-icon>\n    <div>\n      <div class=\"text-h6\" :style=\"{ color: active ? '#d32f2f' : '#2e9e44' }\">{{ active ? 'ALERT' : 'Normal' }}</div>\n      <div class=\"text-caption\">{{ text }}</div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  computed: {\n    active () { return !!(this.msg && this.msg.payload && this.msg.payload.active) },\n    text () { return (this.msg && this.msg.payload && this.msg.payload.text) || 'No unacknowledged alerts' }\n  }\n}\n</script>",
